{
  "setup_data": [],
  "test_cases": [
    {
      "name": "Requests.Register Model Validation",
      "description": "Tests the validation logic of the requests.Register model's Valid() method.",
      "steps": [
        {
          "type": "createModel",
          "description": "Create a valid Register request instance",
          "params": {
            "model_type": "requests.Register",
            "data": {
              "name": "Test User",
              "mail": "valid_user@example.com",
              "password": "StrongPassword!233@",
              "device_token": "dev-001",
              "ip_address": "127.0.0.1",
              "os_name": "Debian",
              "os_version": "12",
              "browser_name": "Safari",
              "browser_version": "12",
              "user_agent": "Mozilla/5.0 (platform; rv:gecko-version) Gecko/gecko-trail Firefox/firefox-version"
            }
          },
          "store_result_as": "validRegisterRequest"
        },
        {
          "type": "executeFunction",
          "description": "Validate the valid Register request (should return nil error)",
          "params": {
            "function_name": "validRegisterRequest.Valid",
            "args": []
          },
          "expected": {
            "return_value": null
          }
        },
        {
          "type": "createModel",
          "description": "Create a Register request with invalid email",
          "params": {
            "model_type": "requests.Register",
            "data": {
              "name": "Test User 2",
              "mail": "invalid-email",
              "password": "StrongPassword!23",
              "device_token": "dev-002"
            }
          },
          "store_result_as": "invalidEmailRequest"
        },
        {
          "type": "executeFunction",
          "description": "Validate request with invalid email (should return error message)",
          "params": {
            "function_name": "invalidEmailRequest.Valid",
            "args": []
          },
          "expected": {
            "return_value": "invalid email format"
          }
        },
        {
          "type": "createModel",
          "description": "Create a Register request with invalid password format",
          "params": {
            "model_type": "requests.Register",
            "data": {
              "name": "Test User 3",
              "mail": "user@example.com",
              "password": "weak",
              "device_token": "dev-003"
            }
          },
          "store_result_as": "invalidPasswordRequest"
        },
        {
          "type": "executeFunction",
          "description": "Validate request with invalid password (should return error message)",
          "params": {
            "function_name": "invalidPasswordRequest.Valid",
            "args": []
          },
          "expected": {
            "return_value": "password does not meet complexity requirements"
          }
        }
      ]
    },
