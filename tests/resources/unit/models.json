    {
      "name": "Models.Utils.UserRoleInfo Structure",
      "description": "Tests the structure and nested access for utils.UserRoleInfo.",
      "steps": [
        {
          "type": "createModel",
          "description": "Create a UserRoleInfo instance with permissions",
          "params": {
            "model_type": "utils.UserRoleInfo",
            "data": {
              "name": "admin",
              "description": "Administrator role",
              "permissions": [
                {"name": "user:read", "view": true, "add": false, "edit": false, "delete": false},
                {"name": "user:write", "view": false, "add": true, "edit": true, "delete": true}
              ]
            }
          },
          "store_result_as": "adminUserRole"
        },
        {
          "type": "assert",
          "description": "Verify role name",
          "params": {
            "actual": "{{ adminUserRole.Name }}", 
            "expected": "admin",
            "operator": "equals"
          }
        },
        {
          "type": "assert",
          "description": "Verify description",
          "params": {
            "actual": "{{ adminUserRole.Description }}", 
            "expected": "Administrator role",
            "operator": "equals"
          }
        },
        {
          "type": "assert",
          "description": "Verify the length of permissions slice",
          "params": {
            "actual": "{{ adminUserRole.Permissions }}", 
            "expected": "2", 
            "operator": "length"
          }
        },
        {
          "type": "assert",
          "description": "Verify the name of the first permission",
          "params": {
            "actual": "{{ adminUserRole.Permissions.0.Name }}", 
            "expected": "user:read",
            "operator": "equals"
          }
        },
        {
          "type": "assert",
          "description": "Verify the 'add' flag of the second permission",
          "params": {
            "actual": "{{ adminUserRole.Permissions.1.Add }}",
            "expected": true,
            "operator": "equals"
          }
        }
      ]
    },
