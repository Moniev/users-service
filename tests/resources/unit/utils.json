{
  "setup_data": [],
  "test_cases": [
    {
      "name": "Email Validation",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Should return true for a valid email",
          "params": {
            "function_name": "utils.CheckEmailFormat",
            "args": ["test.user@example.com"]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for an email with no TLD",
          "params": {
            "function_name": "utils.CheckEmailFormat",
            "args": ["test@example"]
          },
          "expected": {
            "return_value": false
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for an email with consecutive dots in domain",
          "params": {
            "function_name": "utils.CheckEmailFormat",
            "args": ["test@example..com"]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "Password Validation",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Should return true for a valid, strong password",
          "params": {
            "function_name": "utils.CheckPasswordFormat",
            "args": ["ValidPassword123!@#"]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for a password without a digit",
          "params": {
            "function_name": "utils.CheckPasswordFormat",
            "args": ["ValidPassword!@#"]
          },
          "expected": {
            "return_value": false
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for a password without an uppercase letter",
          "params": {
            "function_name": "utils.CheckPasswordFormat",
            "args": ["validpassword123!@#"]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "Token Validation",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Should return true for a valid 6-digit token",
          "params": {
            "function_name": "utils.CheckTokenFormat",
            "args": ["123456"]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for a token with letters",
          "params": {
            "function_name": "utils.CheckTokenFormat",
            "args": ["123a56"]
          },
          "expected": {
            "return_value": false
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for a token that is too short",
          "params": {
            "function_name": "utils.CheckTokenFormat",
            "args": ["12345"]
          },
          "expected": {
            "return_value": false
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for a token that is from letters",
          "params": {
            "function_name": "utils.CheckTokenFormat",
            "args": ["abcdef"]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "Phone Number Validation",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Should return true for a valid international phone number",
          "params": {
            "function_name": "utils.CheckPhoneFormat",
            "args": ["+14155552671"]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for a number with non-digit characters",
          "params": {
            "function_name": "utils.CheckPhoneFormat",
            "args": ["+1-415-555-2671"]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "IBAN Validation",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Should return true for a valid IBAN (example for Poland)",
          "params": {
            "function_name": "utils.CheckIBANFormat",
            "args": ["PL61109010140000071219812874"]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for an IBAN with incorrect country code format",
          "params": {
            "function_name": "utils.CheckIBANFormat",
            "args": ["P161109010140000071219812874"]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "SWIFT/BIC Validation",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Should return true for a valid 8-character SWIFT",
          "params": {
            "function_name": "utils.CheckSWIFTFormat",
            "args": ["DEUTDEFF"]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return true for a valid 11-character SWIFT",
          "params": {
            "function_name": "utils.CheckSWIFTFormat",
            "args": ["DEUTDEFF500"]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for a SWIFT with incorrect length",
          "params": {
            "function_name": "utils.CheckSWIFTFormat",
            "args": ["DEUTDE"]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "HTTP Status Code Validation",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Should return true for a success status code (200)",
          "params": {
            "function_name": "utils.IsSuccessStatusCode",
            "args": [200]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Should return false for a client error status code (404)",
          "params": {
            "function_name": "utils.IsSuccessStatusCode",
            "args": [404]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "Slice and Collection Utilities",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Contains should return true if a string is in the slice",
          "params": {
            "function_name": "utils.Contains",
            "args": [
              ["admin", "user", "guest"],
              "user"
            ]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "Contains should return false if a string is not in the slice",
          "params": {
            "function_name": "utils.Contains",
            "args": [
              ["admin", "user", "guest"],
              "moderator"
            ]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "Role Validation Logic",
      "steps": [
        {
          "type": "executeFunction",
          "description": "ValidateRoles should return true if a required role exists",
          "params": {
            "function_name": "utils.ValidateRoles",
            "args": [
              [
                {"name": "user", "description": "Standard user", "permissions": []},
                {"name": "admin", "description": "Admin user", "permissions": []}
              ],
              ["admin", "superadmin"]
            ]
          },
          "expected": {
            "return_value": true
          }
        },
        {
          "type": "executeFunction",
          "description": "ValidateRoles should return false if no required role exists",
          "params": {
            "function_name": "utils.ValidateRoles",
            "args": [
              [
                {"name": "user", "description": "Standard user", "permissions": []},
                {"name": "guest", "description": "Guest user", "permissions": []}
              ],
              ["admin", "superadmin"]
            ]
          },
          "expected": {
            "return_value": false
          }
        }
      ]
    },
    {
      "name": "GenerateRandomCode",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Generate should return true if a int inside", 
          "params": {
            "function_name": "utils.GenerateRandomCode",
            "args": []
          },
          "store_result_as": "randomCode" 
        },
        {
          "type": "assert",
          "description": "Result should be true", 
          "params": {
            "actual": "{{ randomCode }}",
            "expected": "99999",
            "operator": "greaterThan" 
          }
        },
        {
          "type": "assert",
          "description": "Verify generated code is a 6-digit number (i.e., <= 999999)",
          "params": {
            "actual": "{{ randomCode }}",
            "expected": "1000000",
            "operator": "lessThan" 
          }
        }
      ]
    },
    {
      "name": "GenerateRandomCodes",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Generate a list of random codes",
          "params": {
            "function_name": "utils.GenerateRandomCodes",
            "args": [3]
          },
          "store_result_as": "randomCodes"
        },
        {
          "type": "assert",
          "description": "Verify generated codes are not nil",
          "params": {
            "actual": "{{ randomCodes }}", 
            "operator": "notNil"
          }
        },
        {
          "type": "assert",
          "description": "Verify generated codes length is 3",
          "params": {
            "actual": "{{ randomCodes }}",
            "expected": 3,               
            "operator": "length"
          }
        }
      ]
    },
    {
      "name": "GetUserID Function",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Create context with UserID",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{"UserID": 123}]
          },
          "store_result_as": "ctxWithUserID"
        },
        {
          "type": "executeFunction",
          "description": "Get UserID from context",
          "params": {
            "function_name": "utils.GetUserID",
            "args": ["{{ ctxWithUserID }}"]
          },
          "expected": {
            "return_value": 123
          }
        },
        {
          "type": "executeFunction",
          "description": "Create context without UserID",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{}]
          },
          "store_result_as": "ctxWithoutUserID"
        },
        {
          "type": "executeFunction",
          "description": "Get UserID from empty context",
          "params": {
            "function_name": "utils.GetUserID",
            "args": ["{{ ctxWithoutUserID }}"]
          },
          "expected": {
            "return_value": 0
          }
        },
        {
          "type": "executeFunction",
          "description": "Create context with invalid UserID type",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{"UserID": "not-an-int"}]
          },
          "store_result_as": "ctxWithInvalidUserID"
        },
        {
          "type": "executeFunction",
          "description": "Get UserID from context with invalid type",
          "params": {
            "function_name": "utils.GetUserID",
            "args": ["{{ ctxWithInvalidUserID }}"]
          },
          "expected": {
            "return_value": 0
          }
        }
      ]
    },
    {
      "name": "BindRoles Function",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Create context with user roles",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{"UserRoles": [{"name": "admin", "description": "Admin User", "permissions": []}, {"name": "user", "description": "Standard User", "permissions": []}]}]
          },
          "store_result_as": "ctxWithRoles"
        },
        {
          "type": "executeFunction",
          "description": "Bind roles from context",
          "params": {
            "function_name": "utils.BindRoles",
            "args": ["{{ ctxWithRoles }}"]
          },
          "expected": {
            "return_value": [
              {"name": "admin", "description": "Admin User", "permissions": []},
              {"name": "user", "description": "Standard User", "permissions": []}
            ]
          }
        },
        {
          "type": "executeFunction",
          "description": "Create context without user roles",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{}]
          },
          "store_result_as": "ctxWithoutRoles"
        },
        {
          "type": "executeFunction",
          "description": "Bind roles from empty context",
          "params": {
            "function_name": "utils.BindRoles",
            "args": ["{{ ctxWithoutRoles }}"]
          },
          "return_value": []
        },
        {
          "type": "executeFunction",
          "description": "Create context with invalid UserRoles type",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{"UserRoles": "not-an-array"}]
          },
          "store_result_as": "ctxWithInvalidRoles"
        },
        {
          "type": "executeFunction",
          "description": "Bind roles from context with invalid type",
          "params": {
            "function_name": "utils.BindRoles",
            "args": ["{{ ctxWithInvalidRoles }}"]
          },
          "expected": {
            "return_value": []
          }
        }
      ]
    },
    {
      "name": "GetToken Function",
      "steps": [
        {
          "type": "executeFunction",
          "description": "Create context with Token",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{"Token": "Bearer eyJhbGciOiJIUzI1NiJ9..."}]
          },
          "store_result_as": "ctxWithToken"
        },
        {
          "type": "executeFunction",
          "description": "Get Token from context",
          "params": {
            "function_name": "utils.GetToken",
            "args": ["{{ ctxWithToken }}"]
          },
          "expected": {
            "return_value": "Bearer eyJhbGciOiJIUzI1NiJ9..."
          }
        },
        {
          "type": "executeFunction",
          "description": "Create context without Token",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{}]
          },
          "store_result_as": "ctxWithoutToken"
        },
        {
          "type": "executeFunction",
          "description": "Get Token from empty context",
          "params": {
            "function_name": "utils.GetToken",
            "args": ["{{ ctxWithoutToken }}"]
          },
          "expected": {
            "return_value": ""
          }
        },
        {
          "type": "executeFunction",
          "description": "Create context with invalid Token type",
          "params": {
            "function_name": "tests.GinContextWithData",
            "args": [{"Token": 123}]
          },
          "store_result_as": "ctxWithInvalidToken"
        },
        {
          "type": "executeFunction",
          "description": "Get Token from context with invalid type",
          "params": {
            "function_name": "utils.GetToken",
            "args": ["{{ ctxWithInvalidToken }}"]
          },
          "expected": {
            "return_value": ""
          }
        }
      ]
    }
  ]
}
